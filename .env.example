# Copy to .env in repository root and adjust for your environment.
# Never commit .env or docker/secrets/*.txt

# --- Application ---
APP_ENV=local
APP_URL=http://localhost:8080
FLASK_ENV=development

# --- Edge / ports (host) ---
NGINX_HTTP_PORT=8080
FRONTEND_PORT=3000
POSTGRES_HOST_PORT=5433
AI_DEBUG_PORT=5001
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MAILPIT_UI_PORT=8025

# --- Database ---
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=rms
DB_USERNAME=rms
# DB_PASSWORD is supplied via docker/secrets/db_password.txt

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- AI service ---
AI_SERVICE_URL=http://ai-service:5000

# --- Next.js frontend (optional --profile frontend) ---
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_BASE_PATH=/app
NEXT_PUBLIC_BLADE_URL=http://localhost:8080/login

# --- File storage (dev MinIO) ---
FILE_STORAGE_DRIVER=s3
S3_ENDPOINT=http://minio:9000
S3_BUCKET=rms-uploads
S3_ACCESS_KEY_ID=rmsminio
S3_SECRET_ACCESS_KEY=rmsminio-dev-change-me
S3_USE_PATH_STYLE_ENDPOINT=true

# --- MinIO (dev profile only) ---
MINIO_ROOT_USER=rmsminio
MINIO_ROOT_PASSWORD=rmsminio-dev-change-me

# --- Auth ---
# APP_KEY via docker/secrets/app_key.txt (Laravel base64:... key)
SANCTUM_STATEFUL_DOMAINS=localhost:8080,127.0.0.1:8080

# Optional: path to store.json inside api container (import only by default)
# STORE_JSON_PATH=/import/store.json
# RMS_INTERNAL_SERVICE_TOKEN=rms-dev-internal
# RMS_SMOKE_USERNAME=admin
# RMS_SMOKE_PASSWORD=a3c1993

# Laravel edge (defaults ON — migration complete; opt-out rarely needed)
USE_LARAVEL_EDGE_ROOT=true
USE_LARAVEL_EDGE_UI=true

# Phase 11 slice 1: Flask ai-service (heuristic classify; Laravel falls back to PHP stub)
AI_SERVICE_URL=http://ai-service:5000
# AI_SERVICE_TIMEOUT=3
