# Copy to .env in repository root and adjust for your environment.
# Never commit .env or docker/secrets/*.txt

# --- Application ---
APP_ENV=local
APP_URL=http://localhost:8080
NODE_ENV=development
FLASK_ENV=development
SESSION_SECRET=change-me-to-a-long-random-string

# --- Edge / ports (host) ---
NGINX_HTTP_PORT=8080
POSTGRES_HOST_PORT=5433
AI_DEBUG_PORT=5001
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MAILPIT_UI_PORT=8025

# --- Database ---
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=rms
DB_USERNAME=rms
# DB_PASSWORD is supplied via docker/secrets/db_password.txt

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- AI service ---
AI_SERVICE_URL=http://ai-service:5000

# --- File storage (dev MinIO) ---
FILE_STORAGE_DRIVER=s3
S3_ENDPOINT=http://minio:9000
S3_BUCKET=rms-uploads
S3_ACCESS_KEY_ID=rmsminio
S3_SECRET_ACCESS_KEY=rmsminio-dev-change-me
S3_USE_PATH_STYLE_ENDPOINT=true

# --- MinIO (dev profile only) ---
MINIO_ROOT_USER=rmsminio
MINIO_ROOT_PASSWORD=rmsminio-dev-change-me

# --- Auth ---
# APP_KEY via docker/secrets/app_key.txt (Laravel base64:... key)
SANCTUM_STATEFUL_DOMAINS=localhost:8080,127.0.0.1:8080
# SESSION_SECRET signs Express web cookies (not Laravel)
# Optional: path to store.json inside api container for rms:import-users
# STORE_JSON_PATH=/import/store.json
# Optional future Express→Laravel service token (leave empty; not used for browser login)
# RMS_INTERNAL_SERVICE_TOKEN=
# Inert until later slices (browser login HTML stays Express)
# USE_LARAVEL_ORG=false
# Phase 5 slice 2: Laravel credential verify for Express POST /login (default OFF)
USE_LARAVEL_AUTH=true
# USE_LARAVEL_AUTH_FALLBACK=false
# Phase 5 slice 4: Blade login at /laravel/login (default ON)
USE_LARAVEL_LOGIN_UI=true
# Phase 5 slice 5: Blade admin profile (default ON)
USE_LARAVEL_PROFILE_UI=true
# Phase 5 slice 6: Blade Ticket Reporter profile (default ON)
USE_LARAVEL_REPORTER_PROFILE_UI=true
# Phase 5 slice 7: Blade Ticket Reporter dashboard (default ON)
USE_LARAVEL_REPORTER_DASHBOARD_UI=true
# Phase 5 slice 8: Blade Ticket Reporter ticket lists (default ON)
USE_LARAVEL_REPORTER_TICKETS_UI=true
# Phase 5 slice 9: Blade Ticket Reporter ticket detail (default ON)
USE_LARAVEL_REPORTER_TICKET_DETAIL_UI=true
# Phase 5 slice 10: Blade Ticket Reporter notifications (default ON)
USE_LARAVEL_REPORTER_NOTIFICATIONS_UI=true
# Phase 5 slice 11: Blade Ticket Reporter accomplishments (default ON)
USE_LARAVEL_REPORTER_ACCOMPLISHMENTS_UI=true
# Phase 5 slice 12: Blade Ticket Reporter actions queue (default ON)
USE_LARAVEL_REPORTER_ACTIONS_UI=true
# Phase 5 slice 13: Blade Ticket Reporter create/edit/preview forms (default ON)
USE_LARAVEL_REPORTER_TICKET_FORM_UI=true
# Phase 5 slice 14: Blade admin dashboard (default ON)
USE_LARAVEL_ADMIN_DASHBOARD_UI=true
# Phase 5 slice 15: Blade admin user management (default ON)
USE_LARAVEL_ADMIN_USERS_UI=true
# Phase 5 slice 1: dual-write ON by default (set false to opt out)
USE_LARAVEL_API=true
