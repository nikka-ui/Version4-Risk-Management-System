# Copy to .env.staging (gitignored) and set RMS_SEED_PASSWORD yourself.
#   copy .env.staging.example .env.staging
#
# Start:
#   docker compose -f docker/compose.yml -f docker/compose.staging.yml --env-file .env.staging up -d --build

APP_ENV=staging
APP_DEBUG=false
APP_URL=http://localhost:8080

NGINX_HTTP_PORT=8080
POSTGRES_HOST_PORT=5433
AI_DEBUG_PORT=5001
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MAILPIT_UI_PORT=8025
FRONTEND_PORT=3000

DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=rms
DB_USERNAME=rms

REDIS_HOST=redis
REDIS_PORT=6379

QUEUE_CONNECTION=sync
SANCTUM_STATEFUL_DOMAINS=localhost:8080,127.0.0.1:8080
SANCTUM_EXPIRATION_MINUTES=720

RMS_AI_AUTO_ROUTE=false
RMS_AI_AUTO_ROUTE_MIN_CONFIDENCE=0.75
RMS_RESPONSE_SLA_HOURS=24
RMS_SLA_APPROACHING_HOURS=8
RMS_INTERNAL_SERVICE_TOKEN=
RMS_WORKFLOW_EMAIL=true

# Set a strong password locally before seeding — never commit the real value
RMS_SEED_PASSWORD=

S3_ENDPOINT=http://minio:9000
S3_BUCKET=rms-uploads
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=rmsminio
S3_SECRET_ACCESS_KEY=rmsminio-dev-change-me
S3_USE_PATH_STYLE_ENDPOINT=true

MINIO_ROOT_USER=rmsminio
MINIO_ROOT_PASSWORD=rmsminio-dev-change-me

NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_BASE_PATH=/app
NEXT_PUBLIC_BLADE_URL=http://localhost:8080/login

USE_LARAVEL_EDGE_ROOT=true
USE_LARAVEL_EDGE_UI=true
USE_LARAVEL_INTERNAL_TICKETS=false
USE_LARAVEL_INTERNAL_ORG=false

# Staging compose still defaults MAIL_HOST=mailpit (captured UI :8025).
# For real inbox delivery, override MAIL_HOST/USERNAME/PASSWORD and recreate api.
MAIL_FROM_ADDRESS=noreply@rms.staging.local
MAIL_FROM_NAME=RMS Staging
OTP_MAIL_FROM=itdepartment.accc@gmail.ph
OTP_MAIL_FROM_NAME="ACCC OTP Service"
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=itdepartment.accc@gmail.ph
# MAIL_PASSWORD=
