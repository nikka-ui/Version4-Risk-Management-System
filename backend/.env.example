APP_NAME="RMS API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=rms
DB_USERNAME=rms
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_COOKIE=rms_session
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=rms_

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local non-Docker default: log (OTP bodies go to laravel.log / stderr).
# Docker compose.override: MAIL_MAILER=smtp + MAIL_HOST=mailpit (UI http://127.0.0.1:8025).
# Real inboxes: set MAIL_MAILER=smtp, host/port/user/password for a mailbox that can
# send as OTP_MAIL_FROM. Do not commit real passwords.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Login / password-reset OTP From (Envelope overrides MAIL_FROM_*).
OTP_MAIL_FROM=itdepartment.accc@gmail.ph
OTP_MAIL_FROM_NAME="ACCC OTP Service"
# Example real SMTP (fill MAIL_PASSWORD locally / in secrets — never commit):
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=itdepartment.accc@gmail.ph
# MAIL_PASSWORD=
# MAIL_ENCRYPTION=tls

# Sanctum stateful domains (Phase 1: API tokens only — Express owns browser login)
SANCTUM_STATEFUL_DOMAINS=localhost:8080,127.0.0.1:8080

# Express store.json for `php artisan rms:import-users` (Docker default: /import/store.json)
STORE_JSON_PATH=/import/store.json

# Optional future Express→Laravel service token (empty = disabled)
RMS_INTERNAL_SERVICE_TOKEN=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
